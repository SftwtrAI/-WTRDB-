# ── video-kg service configuration ──
# Copy to `.env` and fill in. Values marked (match v2) MUST be identical to
# version-2.0's .env because this service shares its Postgres, Redis/FalkorDB,
# and JWT secret (it is co-located on the same machine).

# OpenAI — used for hosted multimodal vision + event structuring.
# Supply your own key, OR leave blank to read v2's global_settings.openai_api_key
# from the shared Postgres DB at startup.
OPENAI_API_KEY=
VISION_MODEL=gpt-5
RECONCILE_MODEL=gpt-5-mini
QUERY_MODEL=gpt-5

# Shared infrastructure (match v2)
DATABASE_URL=postgresql://wtrdb_user:password123@localhost:5432/wtrdb
FALKORDB_URL=redis://localhost:6380
JWT_SECRET=paste_the_same_secret_as_v2_here

# version-2.0 server (for the NL query proxy + deep links)
V2_BASE_URL=http://localhost:5001

# Extra browser origins allowed to call this service (comma-separated). The v2 client
# origin is allowed by default; only set this if the client is served from another origin.
# CORS_ORIGINS=

# This service
VIDEO_KG_PORT=6060
DATA_DIR=./data

# Pipeline knobs
MAX_VIDEO_BYTES=2147483648
SAMPLE_FPS=1
SCENE_THRESHOLD=0.4
MAX_FRAMES_PER_WINDOW=6
FRAME_MAX_DIM=768
# Optional: cap how many seconds of video to analyze (0 = whole video)
MAX_ANALYZE_SECONDS=0
# Optional: force CPU x264 instead of VideoToolbox HW accel (set 1 inside Docker)
FFMPEG_FORCE_CPU=0

# The wtrdb user that owns ingested video KBs. Either set a known user id, OR
# set USER_EMAIL/USER_PASSWORD to resolve+login against v2 at ingest time.
DEFAULT_USER_ID=
USER_EMAIL=
USER_PASSWORD=
