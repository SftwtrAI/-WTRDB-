{
  "name": "video-kg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Video-to-Knowledge-Graph service. Ingests a video, extracts temporal events with a hosted multimodal LLM, and injects a graph into the co-located wtrdb version-2.0 (FalkorDB + Postgres) so it is viewable/queryable in version-2.0's existing UI. Does NOT modify version-2.0.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/jobs/worker.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/cli.ts"
  },
  "dependencies": {
    "@tus/file-store": "^1.5.1",
    "@tus/server": "^1.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.77.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
