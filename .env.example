# wtrdb — environment template
# Copy to .env and fill in. Never commit the filled-in file.
# Generate secrets with: openssl rand -base64 32

# ─── Application (required) ──────────────────────────────────────────────
NODE_ENV=development
PORT=5001
APP_URL=http://localhost:5001

# ─── Datastores (required) ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# FalkorDB — the graph store. Must be a Redis with the graph module loaded.
# Separate instance from the Redis cache below.
FALKORDB_URL=redis://localhost:6380
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# Redis — concurrency counters and RBAC permission cache (not a job queue).
REDIS_URL=redis://localhost:6379

# ─── AI (required) ───────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Secrets (required) ──────────────────────────────────────────────────
JWT_SECRET=
# JWT_REFRESH_SECRET is also accepted under the legacy name REFRESH_TOKEN_SECRET.
JWT_REFRESH_SECRET=
SESSION_SECRET=

# Shared secret gating internal-only endpoints: /mcp/*,
# /api/rag-knowledge/tool-webhook, and the internal tools routes.
# Callers send it as the x-internal-api-key header. Never expose to browsers.
INTERNAL_API_KEY=

# ─── Media sidecars (optional; defaults shown) ───────────────────────────
# Where the main server proxies /video-kg and /image-kg. Each service also
# has its own .env — see video-kg/.env.example and image-kg/.env.example.
VIDEO_KG_URL=http://localhost:6060
IMAGE_KG_URL=http://localhost:6061

# ─── Email (optional; required for invites and notifications) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM=

# ─── Billing (optional) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Avatar generation (optional) ────────────────────────────────────────
HEDRA_API_KEY=
HEDRA_API_URL=https://api.hedra.com

# ─── Paths and hosting (optional; sensible defaults) ─────────────────────
# Public domain used to build absolute links. DEV_DOMAIN only applies when
# NODE_ENV is not production. BASE_URL overrides APP_URL for admin-built links.
APP_DOMAIN=
DEV_DOMAIN=
BASE_URL=

# Where the server looks for the built client, and where it stores runtime data.
WTRDB_CLIENT_DIST=
WTRDB_DATA_DIR=

# Set when terminating TLS in-process; also flips a compliance evidence check.
TLS_CERT=

# Base URL used by the RBAC seeding script only.
WTRDB_BASE_URL=http://localhost:5100

# ─── Misc (optional) ─────────────────────────────────────────────────────
# BUILD_NUMBER is injected by CI and reported as the app build; leave unset locally.
LOG_LEVEL=info
