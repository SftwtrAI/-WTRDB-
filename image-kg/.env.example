# ── image-kg service configuration (Wtr.Vision-KG) ──
# Copy to `.env` and fill in. Values marked (match v2) MUST be identical to
# wtrdb-v2's .env because this service shares its Postgres, Redis/FalkorDB, and
# JWT secret (it is co-located on the same machine).

# OpenAI — GPT-5 Vision for extraction + query.
# Supply your own key, OR leave blank to read v2's global_settings.openai_api_key.
OPENAI_API_KEY=
VISION_MODEL=gpt-5
QUERY_MODEL=gpt-5

# Shared infrastructure (match v2)
DATABASE_URL=postgresql://wtrdb_user:password123@localhost:5432/wtrdb
FALKORDB_URL=redis://localhost:6380
JWT_SECRET=paste_the_same_secret_as_v2_here

# wtrdb-v2 server (live-events bridge + deep links)
V2_BASE_URL=http://localhost:5001

# Extra browser origins allowed to call this service (comma-separated).
# CORS_ORIGINS=

# This service
IMAGE_KG_PORT=6061
DATA_DIR=./data

# Provenance / extraction knobs
EXTRACTION_VERSION=v1
PROMPT_VERSION=p1
# Objects/relationships below this confidence are dropped before the graph write.
MIN_CONFIDENCE=0.3
# Max dimension (px) the image is resized to before vision.
IMAGE_MAX_DIM=1024
# Max accepted upload size in bytes (default 25 MiB).
MAX_IMAGE_BYTES=26214400

# The wtrdb user that owns ingested image KBs. Either set a known user id, OR
# set USER_EMAIL/USER_PASSWORD to resolve+login against v2 at ingest time.
DEFAULT_USER_ID=
USER_EMAIL=
USER_PASSWORD=
