{
  "name": "server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/server/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/server"],
      "options": {
        "command": "esbuild apps/server/src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/apps/server --alias:@wtrops/shared=libs/shared/src/index.ts --alias:@wtrops/core=libs/core/src/index.ts",
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_ENV=development tsx watch apps/server/src/index.ts",
        "cwd": "."
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_ENV=development tsx watch apps/server/src/index.ts",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:backend", "type:app"]
}
